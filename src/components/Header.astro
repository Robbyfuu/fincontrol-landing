---


const navItems = [
  { label: 'Características', href: '#features' },
  { label: 'Precios', href: '#pricing' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-200/60 transition-all duration-300 transform" id="main-header">
  <div class="container mx-auto px-4 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-bold text-xl text-slate-900 group">
      <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white group-hover:scale-110 transition-transform">
        F
      </div>
      <span>FinControl</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class="text-sm font-medium text-slate-600 hover:text-blue-600 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTAs -->
    <div class="flex items-center gap-4">
      <a 
        href="https://app.fincontrol.cl/login" 
        class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-slate-700 hover:text-blue-600 transition-colors"
      >
        Iniciar Sesión
      </a>
      <a 
        href="https://app.fincontrol.cl/register" 
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-blue-600 rounded-full hover:bg-blue-700 transition-all hover:shadow-lg shadow-blue-600/20"
      >
        Ir a la App
      </a>
    </div>
  </div>
</header>
