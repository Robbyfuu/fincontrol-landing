---
import { IconBrandWhatsapp, IconArrowRight } from '@tabler/icons-react';

interface Props {
  title?: string;
}
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-100 via-transparent to-transparent opacity-70"></div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_bottom_left,_var(--tw-gradient-stops))] from-purple-100 via-transparent to-transparent opacity-70"></div>
  
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
      
      <!-- Content -->
      <div class="lg:w-1/2 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-sm font-medium mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
          </span>
          Nueva versión con Inteligencia Artificial
        </div>
        
        <h1 class="text-4xl lg:text-6xl font-bold tracking-tight text-slate-900 mb-6 leading-[1.1]">
          El Control de Gastos <br class="hidden lg:block" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">
            Automático por WhatsApp
          </span>
        </h1>
        
        <p class="text-lg text-slate-600 mb-8 max-w-lg mx-auto lg:mx-0 leading-relaxed">
          Olvida guardar boletas y llenar excels. Envía una foto a nuestro bot y la IA procesará tus gastos automáticamente. Ideal para personas y empresas.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
          <a 
            href="https://wa.me/56912345678" 
            target="_blank"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-base font-semibold text-white bg-green-600 rounded-full hover:bg-green-700 transition-colors shadow-lg shadow-green-600/20 w-full sm:w-auto"
          >
            <IconBrandWhatsapp className="w-5 h-5" />
            Comenzar Prueba Gratis
          </a>
          <a
            href="#features"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-base font-medium text-slate-700 bg-white border border-slate-200 rounded-full hover:bg-slate-50 transition-colors w-full sm:w-auto"
          >
            Ver cómo funciona
            <IconArrowRight className="w-4 h-4" />
          </a>
        </div>
        
        <div class="mt-8 flex items-center justify-center lg:justify-start gap-6 text-sm text-slate-500">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Sin tarjeta requerida
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            Setup en 1 minuto
          </div>
        </div>
      </div>
      
      <!-- Visual -->
      <div class="lg:w-1/2 w-full relative">
        <div class="absolute -inset-4 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-[2rem] opacity-10 blur-2xl -z-10"></div>
        <div class="relative bg-white border border-slate-200/60 rounded-[2rem] shadow-2xl overflow-hidden p-2 z-10">
          <img 
            src="/assets/dashboard-mockup.png" 
            alt="Dashboard de FinControl" 
            class="w-full h-auto rounded-[1.5rem]"
          />
        </div>
        
        <!-- Floating Chat Bubble Mockup -->
        <div class="absolute bottom-8 -left-4 lg:-left-12 bg-white p-4 rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 max-w-xs animate-float z-20">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600 shrink-0">
              <IconBrandWhatsapp className="w-6 h-6" />
            </div>
            <div class="space-y-1">
              <p class="text-sm font-medium text-slate-900 flex items-center gap-1">
                Gasto Procesado 
                <span class="text-green-500">✅</span>
              </p>
              <p class="text-xs text-slate-500">Starbucks - $4.500 CLP<br>Categoría: Alimentación</p>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>
